<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usv_rl</name>
  <version>0.0.0</version>
  <description>Minimal RL tooling for SITL-based USV avoidance training.</description>

  <maintainer email="chenhangwei77777@hotmail.com">Chen Hangwei</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>launch_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>common_interfaces</depend>
  <depend>usv_comm</depend>
  <depend>usv_control</depend>
  <depend>usv_bringup</depend>

  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>